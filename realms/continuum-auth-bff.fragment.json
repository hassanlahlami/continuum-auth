{
  "_comment": "ADR 0014 / D41 (accepted 2026-11-02). Confidential clients used ONLY by the backend auth BFF (/api/auth/*), one per front; tokens never reach the browser. continuum-app-bff: direct grant (REST login, realm 'direct grant' flow, OTP only if the user has one, acr always 1) + Code+PKCE S256 terminated by the BFF callback. continuum-admin-bff: direct grant (REST login, acr always 1, tech-lead directive #4691) + Code+PKCE with minimum/default acr 2; /api/admin/** needs acr>=2, so an admin REST session gets 401 step-up-required and the BFF redirects (/api/auth/authorize|step-up?app=admin, acr_values=2 -> OTP) to the same /api/auth/callback (ADR 0014 addendum b; acr>=2 cannot be obtained by direct grant, see recette/spike-d41-direct-grant-acr.sh). Claims: aud via the audience mapper, acr via the default 'acr' client scope. Both use the browser flow override continuum-browser-loa (step-up: acr_values=2 -> OTP; LoA max ages are technical defaults, to validate against the pack). No hardcoded acr mapper. Merge with realms/merge-fragments.py (clients[] + authenticationFlows[] + authenticatorConfig[]); secrets from env KC_APP_BFF_SECRET / KC_ADMIN_BFF_SECRET, never committed. Callback: <front origin>/api/auth/callback (same origin, ADR 0014 addendum); sim origins below, prod origins come from the deployment.",
  "clients": [
    {
      "clientId": "continuum-app-bff",
      "name": "Continuum - auth BFF, functional app",
      "description": "ADR 0014 / D41. Server-side only (backend BFF). Direct grant + Code+PKCE (redirect fallback, SSO, step-up).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_APP_BFF_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://localhost:4200/api/auth/callback",
        "http://localhost:4203/api/auth/callback"
      ],
      "webOrigins": [],
      "defaultClientScopes": [
        "basic",
        "acr",
        "profile",
        "email"
      ],
      "optionalClientScopes": [],
      "authenticationFlowBindingOverrides": {
        "browser": "6d8a3c1e-4f2b-4c7a-9e51-0b7d2a1f4c01"
      },
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "acr.loa.map": "{\"1\":1,\"2\":2}",
        "client.session.idle.timeout": "900",
        "access.token.lifespan": "300",
        "use.refresh.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "aud-continuum-app",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "continuum-app",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "continuum_user_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "continuum_user_id",
            "claim.name": "continuum_user_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "continuum-admin-bff",
      "name": "Continuum - auth BFF, system admin",
      "description": "ADR 0014 / D41. Server-side only (backend BFF). Direct grant (REST login, acr 1, OTP only if the user has one) + Code+PKCE at acr 2 (OTP).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_ADMIN_BFF_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://localhost:4201/api/auth/callback",
        "http://localhost:4202/api/auth/callback"
      ],
      "webOrigins": [],
      "defaultClientScopes": [
        "basic",
        "acr",
        "profile",
        "email"
      ],
      "optionalClientScopes": [],
      "authenticationFlowBindingOverrides": {
        "browser": "6d8a3c1e-4f2b-4c7a-9e51-0b7d2a1f4c01"
      },
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "acr.loa.map": "{\"1\":1,\"2\":2}",
        "default.acr.values": "2",
        "minimum.acr.value": "2",
        "client.session.idle.timeout": "900",
        "access.token.lifespan": "300",
        "use.refresh.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "aud-continuum-admin",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "continuum-admin",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "continuum_user_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "continuum_user_id",
            "claim.name": "continuum_user_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
